{
  "name": "mos-card",
  "private": true,
  "type": "module",
  "description": "Lovelace card for the MOS NAS Home Assistant integration",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "lovelace",
    "custom-cards",
    "mos",
    "nas",
    "docker",
    "lxc",
    "proxmox"
  ],
  "author": "anym001",
  "license": "MIT",
  "dependencies": {
    "custom-card-helpers": "2.0.0",
    "home-assistant-js-websocket": "9.7.1",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.1",
    "@rollup/plugin-typescript": "^12.3.1",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.7",
    "prettier": "^3.9.10",
    "rollup": "^4.64.12",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-serve": "^3.0.0",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^8",
    "vitest": "^5"
  },
  "scripts": {
    "build": "npm run clean && npm run lint && npm run rollup",
    "check": "npm run lint && npm run typecheck && npm test && npm run lint:format && npm run build",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "lint:format": "prettier --check .",
    "rollup": "rollup -c",
    "start": "rollup -c rollup.config.dev.js --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anym001/ha-mos.git",
    "directory": "frontend"
  },
  "overrides": {
    "eslint-plugin-import": {
      "eslint": "$eslint"
    }
  }
}
