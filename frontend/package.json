{
  "name": "mos-card",
  "private": true,
  "type": "module",
  "packageManager": "yarn@4.12.0",
  "description": "Lovelace card for the MOS NAS Home Assistant integration",
  "keywords": [
    "home-assistant",
    "homeassistant",
    "hass",
    "lovelace",
    "custom-cards",
    "mos",
    "nas",
    "docker",
    "lxc",
    "proxmox"
  ],
  "author": "anym001",
  "license": "MIT",
  "dependencies": {
    "custom-card-helpers": "2.0.0",
    "home-assistant-js-websocket": "9.7.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "markdownlint-cli2": "^0.23.3",
    "prettier": "^3.9.9",
    "rollup": "^4.63.5",
    "rollup-plugin-esbuild": "^6.2.1",
    "rollup-plugin-serve": "^3.0.0",
    "typescript": "^5.9.3",
    "vite": "^8",
    "vitest": "^5"
  },
  "scripts": {
    "build": "yarn clean && yarn lint && yarn rollup",
    "check": "yarn lint && yarn typecheck && yarn test && yarn lint:md && yarn lint:format && yarn lint:dedupe && yarn build",
    "clean": "rm -rf dist",
    "lint": "eslint src/**/*.ts tests/**/*.ts",
    "lint:format": "prettier --check .",
    "lint:dedupe": "yarn dedupe --check home-assistant-js-websocket",
    "lint:md": "markdownlint-cli2 \"**/*.md\"",
    "rollup": "rollup -c",
    "start": "rollup -c rollup.config.dev.js --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anym001/ha-mos.git",
    "directory": "frontend"
  }
}
