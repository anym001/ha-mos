{
  // Files and directories excluded from markdownlint validation.
  // Keep in sync with .prettierignore — markdownlint-cli2 does NOT support .markdownlintignore.
  "ignores": [
    // Runtime / generated directories
    "node_modules/**",
    "config/**",
    ".local/**",
    // custom_components/hacs is a third-party integration — only lint our own integration
    "custom_components/hacs/**",
    // Auto-generated release file
    "CHANGELOG.md",
    // Symlinks into .agents/ — lint the real directories once.
    // No .github/instructions/** here: that Copilot-facing symlink is not used
    // in this repository, which reads .agents/instructions/ directly.
    ".claude/rules/**",
    ".claude/skills/**",
    // Agent scratch space — generated notes and reports, never committed
    ".agents/scratch/**"
  ]
}
