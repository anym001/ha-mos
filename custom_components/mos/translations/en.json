{
  "config": {
    "step": {
      "user": {
        "description": "Enter the connection details for your MOS server. Create an API token in the MOS web UI. If you need help, have a look at the [documentation]({documentation_url}).",
        "data": {
          "name": "Name",
          "host": "Host",
          "api_token": "API token",
          "port": "Port",
          "ssl": "Use HTTPS",
          "verify_ssl": "Verify TLS certificate"
        },
        "data_description": {
          "name": "A friendly name for this MOS server. Used as the entry's stable identity, independent of the host.",
          "host": "Host name or IP address of the MOS server.",
          "api_token": "Read-only is enough for monitoring; starting and stopping needs write access. A token scoped to the areas you use is preferable to an admin token.",
          "port": "Defaults to 443 with HTTPS, 80 without.",
          "ssl": "Use HTTPS. Without it the API token is sent in clear text.",
          "verify_ssl": "Check the server's TLS certificate. Turn this off only for a self-signed certificate."
        }
      },
      "reconfigure": {
        "description": "Update the connection details for this MOS server.",
        "data": {
          "host": "Host",
          "api_token": "API token",
          "port": "Port",
          "ssl": "Use HTTPS",
          "verify_ssl": "Verify TLS certificate"
        },
        "data_description": {
          "host": "Host name or IP address of the MOS server.",
          "api_token": "Read-only is enough for monitoring; starting and stopping needs write access. A token scoped to the areas you use is preferable to an admin token.",
          "port": "Defaults to 443 with HTTPS, 80 without.",
          "ssl": "Use HTTPS. Without it the API token is sent in clear text.",
          "verify_ssl": "Check the server's TLS certificate. Turn this off only for a self-signed certificate."
        }
      },
      "reauth_confirm": {
        "title": "Reauthenticate MOS NAS",
        "description": "The API token for {host} is no longer valid. Please provide a new token to restore access.",
        "data": {
          "api_token": "API token"
        },
        "data_description": {
          "api_token": "Create the new token in the MOS web UI under User Settings, Admin API Tokens. It needs the same access as the one it replaces."
        }
      }
    },
    "error": {
      "auth": "The API token was rejected by {host}. Double-check that this is the correct host/IP for your MOS server and that you copied the full token correctly.",
      "connection": "Unable to connect to {host}. Double-check the host/IP, port and HTTPS settings.",
      "permission": "The API token is valid but not authorized to read system information. Grant it read access to this resource in the MOS web UI.",
      "unknown": "Unknown error occurred."
    },
    "abort": {
      "already_configured": "This MOS server is already configured.",
      "reauth_successful": "Re-authentication was successful.",
      "reconfigure_successful": "Reconfiguration was successful."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "MOS NAS options",
        "description": "Customize how this integration operates.",
        "data": {
          "scan_interval": "Update interval (seconds)",
          "enable_disks": "Enable disks",
          "enable_pools": "Enable storage pools",
          "enable_services": "Enable services",
          "enable_lxc": "Enable LXC containers",
          "enable_docker": "Enable Docker containers",
          "enable_vm": "Enable VMs",
          "enable_sensors": "Enable hardware sensors",
          "enable_nut": "Enable UPS"
        },
        "data_description": {
          "scan_interval": "How often to poll the MOS API (30 to 3600 seconds).",
          "enable_disks": "Create entities for physical disks.",
          "enable_pools": "Create entities for storage pools.",
          "enable_services": "Create entities for system services (Docker, VM, SSH, ...).",
          "enable_lxc": "Create entities for each LXC container.",
          "enable_docker": "Create entities for each Docker container.",
          "enable_vm": "Create entities for each VM.",
          "enable_sensors": "Create entities for hardware readings (fans, temperatures, voltages, ...).",
          "enable_nut": "Create entities for the UPS MOS monitors via Network UPS Tools."
        }
      }
    }
  },
  "exceptions": {
    "authentication_failed": {
      "message": "Authentication failed during data update."
    },
    "authentication_failed_transient": {
      "message": "The server rejected the API token, but this may be temporary (e.g. the server is restarting). Retrying before requiring re-authentication."
    },
    "update_failed": {
      "message": "Failed to update data from the server."
    },
    "lxc_start_failed": {
      "message": "Failed to start LXC container {name}."
    },
    "lxc_stop_failed": {
      "message": "Failed to stop LXC container {name}."
    },
    "docker_start_failed": {
      "message": "Failed to start Docker container {name}."
    },
    "docker_stop_failed": {
      "message": "Failed to stop Docker container {name}."
    },
    "vm_start_failed": {
      "message": "Failed to start VM {name}."
    },
    "vm_stop_failed": {
      "message": "Failed to stop VM {name}."
    },
    "insufficient_write_permission": {
      "message": "The configured API token does not have write access to {resource}."
    },
    "insufficient_read_permission": {
      "message": "The configured API token does not have read access to {resource}, which this integration always needs. Grant it read access to this resource in the MOS web UI."
    }
  },
