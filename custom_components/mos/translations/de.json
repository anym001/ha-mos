      },
      "reconfigure": {
        "description": "Aktualisiere die Verbindungsdaten für diesen MOS-Server.",
        "data": {
          "host": "Host",
          "api_token": "API-Token",
          "port": "Port",
          "ssl": "HTTPS verwenden",
          "verify_ssl": "TLS-Zertifikat überprüfen"
        }
      },
      "reauth_confirm": {
        "title": "MOS NAS erneut authentifizieren",
        "description": "Das API-Token für {host} ist nicht mehr gültig. Gib ein neues Token ein, um den Zugriff wiederherzustellen.",
        "data": {
          "api_token": "API-Token"
        }
      }
    },
    "error": {
      "auth": "Das API-Token wurde von {host} abgelehnt. Prüfe, ob dies der richtige Host bzw. die richtige IP für deinen MOS-Server ist und ob du das vollständige Token korrekt kopiert hast.",
      "connection": "Verbindung zu {host} nicht möglich. Prüfe Host/IP, Port und die HTTPS-Einstellungen.",
      "permission": "Das API-Token ist gültig, hat aber keine Berechtigung, Systeminformationen zu lesen. Gewähre ihm in der MOS-Web-UI Lesezugriff auf diese Ressource.",
      "unknown": "Unbekannter Fehler aufgetreten."
    },
    "abort": {
      "already_configured": "Dieser MOS-Server ist bereits konfiguriert.",
      "reauth_successful": "Die erneute Authentifizierung war erfolgreich.",
      "reconfigure_successful": "Die Neukonfiguration war erfolgreich."
    }
  },
