{
  "config": {
    "step": {
      "user": {
        "description": "Gib die Verbindungsdaten für deinen MOS-Server ein. Erstelle einen API-Token in der MOS-Web-UI. Falls du Hilfe brauchst, wirf einen Blick in die [Dokumentation]({documentation_url}).",
        "data": {
          "name": "Name",
          "host": "Host",
          "api_token": "API-Token",
          "port": "Port",
          "ssl": "HTTPS verwenden",
          "verify_ssl": "TLS-Zertifikat überprüfen"
        },
        "data_description": {
          "name": "Ein frei wählbarer Name für diesen MOS-Server. Dient als stabile Identität des Eintrags, unabhängig vom Host.",
          "host": "Hostname oder IP-Adresse des MOS-Servers.",
          "api_token": "Für die reine Überwachung genügt Lesezugriff; Starten und Stoppen braucht Schreibzugriff. Ein auf die genutzten Bereiche eingeschränkter Token ist einem Admin-Token vorzuziehen.",
          "port": "Standard ist 443 mit HTTPS, sonst 80.",
          "ssl": "HTTPS verwenden. Ohne HTTPS wird der API-Token im Klartext übertragen.",
          "verify_ssl": "Das TLS-Zertifikat des Servers prüfen. Nur bei einem selbstsignierten Zertifikat deaktivieren."
        }
      },
      "reconfigure": {
        "description": "Aktualisiere die Verbindungsdaten für diesen MOS-Server.",
        "data": {
          "host": "Host",
          "api_token": "API-Token",
          "port": "Port",
          "ssl": "HTTPS verwenden",
          "verify_ssl": "TLS-Zertifikat überprüfen"
        },
        "data_description": {
          "host": "Hostname oder IP-Adresse des MOS-Servers.",
          "api_token": "Für die reine Überwachung genügt Lesezugriff; Starten und Stoppen braucht Schreibzugriff. Ein auf die genutzten Bereiche eingeschränkter Token ist einem Admin-Token vorzuziehen.",
          "port": "Standard ist 443 mit HTTPS, sonst 80.",
          "ssl": "HTTPS verwenden. Ohne HTTPS wird der API-Token im Klartext übertragen.",
          "verify_ssl": "Das TLS-Zertifikat des Servers prüfen. Nur bei einem selbstsignierten Zertifikat deaktivieren."
        }
      },
      "reauth_confirm": {
        "title": "MOS NAS erneut authentifizieren",
        "description": "Der API-Token für {host} ist nicht mehr gültig. Gib einen neuen Token ein, um den Zugriff wiederherzustellen.",
        "data": {
          "api_token": "API-Token"
        },
        "data_description": {
          "api_token": "Erstelle den neuen Token in der MOS-Web-UI unter Benutzereinstellungen, Admin-API-Tokens. Er braucht dieselben Rechte wie der bisherige."
        }
      }
    },
    "error": {
      "auth": "Der API-Token wurde von {host} abgelehnt. Prüfe, ob dies der richtige Host bzw. die richtige IP für deinen MOS-Server ist und ob du den vollständigen Token korrekt kopiert hast.",
      "connection": "Verbindung zu {host} nicht möglich. Prüfe Host/IP, Port und die HTTPS-Einstellungen.",
      "permission": "Der API-Token ist gültig, hat aber keine Berechtigung, Systeminformationen zu lesen. Gewähre ihm in der MOS-Web-UI Lesezugriff auf diese Ressource.",
      "unknown": "Unbekannter Fehler aufgetreten."
    },
    "abort": {
      "already_configured": "Dieser MOS-Server ist bereits konfiguriert.",
      "reauth_successful": "Die erneute Authentifizierung war erfolgreich.",
      "reconfigure_successful": "Die Neukonfiguration war erfolgreich."
    }
  },
  "options": {
    "step": {
      "init": {
        "title": "MOS NAS Optionen",
        "description": "Passe an, wie diese Integration arbeitet.",
        "data": {
          "scan_interval": "Aktualisierungsintervall (Sekunden)",
          "enable_disks": "Festplatten aktivieren",
          "enable_pools": "Speicherpools aktivieren",
          "enable_services": "Dienste aktivieren",
          "enable_lxc": "LXC-Container aktivieren",
          "enable_docker": "Docker-Container aktivieren",
          "enable_docker_stats": "Docker-Auslastung aktivieren",
          "enable_compose": "Compose-Stacks aktivieren",
          "enable_compose_stats": "Compose-Auslastung aktivieren",
          "enable_vm": "VMs aktivieren",
          "enable_sensors": "Hardware-Sensoren aktivieren",
          "enable_nut": "USV aktivieren"
        },
        "data_description": {
          "scan_interval": "Wie oft die MOS-API abgefragt wird (30 bis 3600 Sekunden).",
          "enable_disks": "Entitäten für physische Festplatten anlegen.",
          "enable_pools": "Entitäten für Speicherpools anlegen.",
          "enable_services": "Entitäten für Systemdienste anlegen (Docker, VM, SSH, ...).",
          "enable_lxc": "Entitäten für jeden LXC-Container anlegen.",
          "enable_docker": "Entitäten für jeden Docker-Container anlegen.",
          "enable_docker_stats": "CPU- und Speicher-Sensoren für jeden Docker-Container anlegen. Kostet pro laufendem Container eine zusätzliche Abfrage je Poll - bei vielen Containern besser ausgeschaltet lassen.",
          "enable_compose": "Entitäten für jeden Docker-Compose-Stack anlegen. Ein Stack ist ein Gerät für alle seine Services; seine Container tauchen nicht einzeln unter den Docker-Containern auf.",
          "enable_compose_stats": "CPU- und Speicher-Sensoren für jeden Compose-Stack anlegen, summiert über seine Services. Kostet pro laufendem Service eine zusätzliche Abfrage je Poll - wenige große Stacks kosten also mehr als viele kleine.",
          "enable_vm": "Entitäten für jede VM anlegen.",
          "enable_sensors": "Entitäten für Hardware-Messwerte anlegen (Lüfter, Temperaturen, Spannungen, ...).",
          "enable_nut": "Entitäten für die USV anlegen, die MOS über Network UPS Tools überwacht."
        }
      }
    }
  },
  "exceptions": {
    "authentication_failed": {
      "message": "Authentifizierung während der Datenaktualisierung fehlgeschlagen."
    },
    "authentication_failed_transient": {
      "message": "Der Server hat den API-Token abgelehnt, das kann aber vorübergehend sein (z. B. weil der Server neu startet). Es wird erneut versucht, bevor eine erneute Authentifizierung nötig wird."
    },
    "update_failed": {
      "message": "Aktualisierung der Daten vom Server fehlgeschlagen."
    },
    "lxc_start_failed": {
      "message": "Start des LXC-Containers {name} fehlgeschlagen."
    },
    "lxc_stop_failed": {
      "message": "Stopp des LXC-Containers {name} fehlgeschlagen."
    },
    "compose_start_failed": {
      "message": "Compose-Stack {name} konnte nicht gestartet werden."
    },
    "compose_stop_failed": {
      "message": "Compose-Stack {name} konnte nicht gestoppt werden."
    },
    "docker_start_failed": {
      "message": "Start des Docker-Containers {name} fehlgeschlagen."
    },
    "docker_stop_failed": {
      "message": "Stopp des Docker-Containers {name} fehlgeschlagen."
    },
    "vm_start_failed": {
      "message": "Start der VM {name} fehlgeschlagen."
    },
    "vm_stop_failed": {
      "message": "Stopp der VM {name} fehlgeschlagen."
    },
    "insufficient_write_permission": {
      "message": "Der konfigurierte API-Token hat keinen Schreibzugriff auf {resource}."
    },
    "insufficient_read_permission": {
      "message": "Der konfigurierte API-Token hat keinen Lesezugriff auf {resource}, den diese Integration immer benötigt. Gewähre ihm in der MOS-Web-UI Lesezugriff auf diese Ressource."
    }
